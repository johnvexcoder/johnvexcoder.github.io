# Owner-confirmed production origin for V2 (10 October 2026).
NEXT_PUBLIC_SITE_URL=https://johnvexcoder.github.io
# Use preview for a separate staging build: noindex, empty sitemap, robots allow crawl.
SITE_INDEXING=production
# Optional local-console Core Web Vitals diagnostics in a production test build.
# NEXT_PUBLIC_PERFORMANCE_DEBUG=true
# Optional public verification value supplied by your Google Search Console property.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: your public Web3Forms access identifier. Existing source configuration is the fallback.
# NEXT_PUBLIC_REVIEW_ACCESS_KEY=
# Optional separate public Web3Forms contact identifier; otherwise the review identifier is shared.
# NEXT_PUBLIC_CONTACT_ACCESS_KEY=
